# لوحة التحكم (npm run admin)
ADMIN_PORT=3000
ADMIN_HOST=0.0.0.0
# اختياري — إن وُضعت تُطلب عند فتح اللوحة والحفظ
# ADMIN_PASSWORD=your-secret-here

# Chrome / Chromium (اتركه فارغاً على Windows إذا المسار الافتراضي صحيح)
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
# PUPPETEER_HEADLESS=0

# حساب واتساب عند التشغيل (أو مرّر المعرّف: node bot.js majed)
# WA_ACCOUNT_ID=majed

# مجلد جلسات واتساب (اختياري)
# WWEBJS_AUTH_PATH=
