# لوحة التحكم / السحابة
ADMIN_PORT=3000
ADMIN_HOST=0.0.0.0
# PORT=3000
# CLOUD=1
# NODE_ENV=production
# اختياري — إن وُضعت تُطلب عند فتح اللوحة والحفظ
# ADMIN_PASSWORD=your-secret-here

# ——— Interakt (واتساب الرسمي) ———
# من Interakt → Settings → Developer Settings
INTERAKT_API_KEY=
INTERAKT_WEBHOOK_SECRET=
INTERAKT_COUNTRY_CODE=+966
# اسم قالب الرد المعتمد من Meta (نص القالب: {{1}} فقط)
INTERAKT_REPLY_TEMPLATE=bot_reply
INTERAKT_REPLY_LANGUAGE=ar
# template = إرسال | off = تعطيل الإرسال (اختبار)
INTERAKT_SEND_MODE=template

# ——— كوبري الحسبة ———
# إن وُضع يُطلب في الهيدر: X-Api-Key أو Authorization: Bearer
CALC_BRIDGE_API_KEY=

# ——— واتساب ويب المحلي (اختياري — للتشغيل القديم) ———
# WA_ACCOUNT_ID=majed
# PUPPETEER_EXECUTABLE_PATH=
# PUPPETEER_HEADLESS=0
# WWEBJS_AUTH_PATH=
