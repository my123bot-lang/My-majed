ADMIN_PORT=3000
ADMIN_HOST=0.0.0.0
CLOUD=1

# Interakt — استقبال + إرسال (نفس منطق البوت)
INTERAKT_API_KEY=
INTERAKT_WEBHOOK_SECRET=
INTERAKT_COUNTRY_CODE=+966
INTERAKT_REPLY_TEMPLATE=bot_reply
INTERAKT_REPLY_LANGUAGE=ar
# auto = نص حر داخل 24س (بعد ما العميل يكتب) ثم قالب احتياطي
INTERAKT_SEND_MODE=auto

# اختياري: جوالك الشخصي فقط (غير رقم البوت مثل 0507009290) لأزرار التحكم عن بُعد
# إذا رقم البوت = واتساب العمل: اتركه فارغاً واستخدم stop داخل شات العميل أو زر سجل العملاء
OWNER_CONTROL_PHONES=
# على واتساب ويب المحلي: أي رد يدوي منك يوقف الرد الآلي لذلك العميل (1=تشغيل)
HUMAN_TAKEOVER_ON_REPLY=1

# قفل اختياري لمسار /api/calc (إن استُخدم)
# CALC_BRIDGE_API_KEY=
