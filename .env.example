# لوحة التحكم / السحابة
ADMIN_PORT=3000
ADMIN_HOST=0.0.0.0
# PORT=3000
CLOUD=1
# NODE_ENV=production

# ——— Meta WhatsApp Cloud API (ردود حرة خلال 24 ساعة) ———
# من Meta Developer → WhatsApp → API Setup
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
# أي نص تختاره — نفس القيمة تضعها في Meta عند إعداد Webhook
META_WA_VERIFY_TOKEN=majed_verify
# من إعدادات التطبيق (App Secret) — للتحقق من توقيع الـ webhook
META_APP_SECRET=
# META_GRAPH_VERSION=v21.0

# ——— كوبري الحسبة ———
# CALC_BRIDGE_API_KEY=

# ——— Interakt (اختياري — غير مستخدم للردود في خيار Cloud API) ———
# INTERAKT_API_KEY=
# INTERAKT_WEBHOOK_SECRET=
INTERAKT_SEND_MODE=off
